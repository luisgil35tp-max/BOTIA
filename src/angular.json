{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "botia": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": { "production": { "target": "botia:esbuild:production" }, "development": { "target": "botia:esbuild:development", "dev": true } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-architects/native-federation:build", "options": { "target": "botia:serve-original:development", "port": 4200, "dev": true } },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": { "browser": "main.ts", "polyfills": ["zone.js", "es-module-shims"], "tsConfig": "tsconfig.app.json", "inlineStyleLanguage": "scss", "styles": ["styles.scss"] },
          "configurations": {
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true },
            "production": { "outputHashing": "all", "fileReplacements": [{ "replace": "environments/environment.ts", "with": "environments/environment.prod.ts" }] }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "botia:esbuild:development", "port": 4200 } }
      }
    }
  },
  "cli": { "analytics": false }
}
